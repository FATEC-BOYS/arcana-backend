DATABASE_URL=postgresql+psycopg://arcana:arcana@localhost:5432/arcana
CORS_ORIGINS=["http://localhost:4200"]
# Set a unique random secret before deploying.
RATE_LIMIT_SECRET=local-development-only
PUBLIC_FRONTEND_URL=http://localhost:4200
# Set locally to enable real model calls. No key = explicit failed generation.
# OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
DAILY_READING_LIMIT=20
MAX_MESSAGES_PER_READING=30
# Optional password recovery via SMTP. No email is sent until configured.
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
